# GlitchTip MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your GlitchTip API URL (include trailing slash)
GLITCHTIP_API_URL=https://your-glitchtip.example.com/api/0/

# Required: API token from GlitchTip
# Generate at: https://your-glitchtip.example.com/settings/api-tokens
GLITCHTIP_AUTH_TOKEN=your_token_here

# Optional: Default organization/project for get_glitchtip_issues when not passed per call.
# When unset, use list_glitchtip_organizations and list_glitchtip_projects, then pass org/project when calling get_glitchtip_issues.
# GLITCHTIP_ORGANIZATION=your-org-slug
# GLITCHTIP_PROJECT=your-project-slug

# Optional: Only allow server to start when run from these IPs (comma-separated IPv4 or CIDR)
# GLITCHTIP_ALLOWED_IPS=192.168.1.1,10.0.0.0/8

# Optional: Transport - stdio (default) or streamable-http. Use streamable-http for Docker/remote.
# MCP_TRANSPORT=streamable-http
# Optional: When MCP_TRANSPORT=streamable-http, bind host and port. Endpoint: http://<host>:<port>/mcp
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8000
